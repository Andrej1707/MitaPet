{
  "name": "mita-desktop-pet",
  "version": "2.0.3",
  "description": "Standalone Windows desktop pet app for MitaPet.",
  "main": "src/main.js",
  "author": "PC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/smoke-test.js",
    "test:capture": "electron scripts/capture-clean-smoke.js",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --win dir"
  },
  "build": {
    "appId": "local.mitadesktoppet.app",
    "productName": "MitaDesktopPet",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "src/main.js"
    },
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MitaDesktopPet-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^26.8.1"
  }
}
